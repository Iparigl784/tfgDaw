# Variables de entorno para Docker Compose

# UID y GID del usuario host (para permisos)
UID=1000
GID=1000
COMPOSER_ALLOW_SUPERUSER=1

# Puerto para Apache
HTTP_PORT=8081

# Puerto para PHPMyAdmin
PMA_PORT=8084

# Puerto para MySQL
MYSQL_PORT=3308

# Datos de MySQL
DB_ROOT_PASSWORD=1234
DB_DATABASE=meetng-db
DB_USER=ivan
DB_PASSWORD=1234
